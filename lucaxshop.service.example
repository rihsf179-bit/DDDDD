[Unit]
Description=Luca X Shop Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/lucaxshop
EnvironmentFile=/opt/lucaxshop/.env
ExecStart=/opt/lucaxshop/.venv/bin/python -u /opt/lucaxshop/bot.py
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
